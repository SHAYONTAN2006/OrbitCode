# ============================================================
# RUNNER - Environment Variables
# These are set automatically by ECS via the Task Definition
# and container environment overrides. You only need this
# .env file for LOCAL development/testing of the runner.
# ============================================================

# --- Injected by ECS at runtime ---
# The unique ID of the Repl this container is serving
REPL_ID=test-repl-123

# --- S3 ---
# The name of your S3 bucket (e.g. my-replit-clone-storage)
S3_BUCKET=

# --- AWS Region ---
AWS_REGION=us-east-1

# Note: In production (ECS), AWS credentials are NOT needed here.
# The container automatically uses the ECS Task Role for S3 access.
# Only fill these in for local testing:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Server ---
PORT=8080
