# ============================================================
# ORCHESTRATOR - Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# --- AWS Credentials ---
# The IAM user/role that has permission to call ecs:RunTask, ecs:DescribeTasks,
# and s3:CopyObject on your bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- S3 ---
# The name of your S3 bucket (e.g. my-replit-clone-storage)
S3_BUCKET=

# --- ECS ---
# The name of your ECS Cluster (e.g. replit-cluster)
ECS_CLUSTER_NAME=

# The full ARN of your ECS Task Definition
# (e.g. arn:aws:ecs:us-east-1:478502031495:task-definition/replit-runner-node:1)
ECS_TASK_DEFINITION_ARN=

# The container name inside the ECS task definition (e.g. Main)
ECS_CONTAINER_NAME=Main

# Comma-separated list of subnet IDs for Fargate to launch tasks into
# These can be PUBLIC or PRIVATE subnets:
# - PUBLIC: assignPublicIp is ENABLED (less secure, but simpler)
# - PRIVATE: assignPublicIp is DISABLED, requires S3 VPC Endpoint + Gateway in same VPC
# (e.g. subnet-abc123,subnet-def456)
ECS_SUBNETS=

# Comma-separated list of security group IDs to attach to Fargate tasks
# Make sure these SGs allow:
#   - Outbound on port 443 (for S3 VPC Endpoint / ECR pulls)
#   - Inbound from Gateway on port 8080 (if Gateway is in same VPC)
# (e.g. sg-0123456789abcdef0)
ECS_SECURITY_GROUPS=

# Local testing only: use a manually started runner instead of ECS.
# LOCAL_RUNNER_URL=http://localhost:5001

# --- Server ---
PORT=3000
