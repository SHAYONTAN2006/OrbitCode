# ============================================================
# FRONTEND - Environment Variables
# Copy this file to .env and fill in your values.
# Vite requires all env variables to be prefixed with VITE_
# ============================================================

# URL of your deployed Orchestrator API
# For local dev: http://localhost:3000
VITE_ORCHESTRATOR_URL=http://localhost:3000

# Stable browser-facing Execution Gateway URL
VITE_EXECUTION_GATEWAY_URL=http://localhost:4000
