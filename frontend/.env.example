# ============================================================
# FRONTEND - Environment Variables
# Copy this file to .env and fill in your values.
# Vite requires all env variables to be prefixed with VITE_
# ============================================================

# URL of your deployed Orchestrator API
# For local dev: http://localhost:3000
VITE_ORCHESTRATOR_URL=http://localhost:3000

# For local dev only: the WebSocket URL of the runner
# In production this is set dynamically per user from the Orchestrator response
VITE_EXECUTION_ENGINE_URI=ws://localhost:8080
